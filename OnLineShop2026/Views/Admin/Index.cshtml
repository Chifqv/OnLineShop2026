@model List<User>
@{
    ViewData["Title"] = "Пользователи";
}

<div class="row mt-3">
    <div class="col-9 mb-3">
        <div class="text-center text-uppercase text-success mb-5 mt-5">
            <h2 class="row-title">Пользователи</h2>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="row justify-content-center mt-3">
                <div class="col-12">
                    <table class="table table-responsive table-striped table-hover mb-5">
                        <thead>
                            <tr align="center">
                                <th scope="col"></th>
                                <th scope="col">Email</th>
                                <th scope="col">Имя</th>
                                <th scope="col">Фамилия</th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Count; i++)
                            {
                                <tr align="center" class="align-baseline">
                                    <td class="fw-bold">@(i + 1)</td>
                                    <td align="left">@Model[i].Email</td>
                                    <td>@Model[i].Name</td>
                                    <td>@Model[i].Sername</td>
                                    <td align="left">
                                        <a class="text-success"
                                           asp-controller="User"
                                           asp-action="Index"
                                           asp-route-id="@Model[i].Id">
                                            Подробнее
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <h2 class="row-title">В хранилище нет пользователей!</h2>
            </div>
        }
    </div>
</div>